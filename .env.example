# ==============================================================================
# Artemis Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# LLM Providers (Configure at least one)
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPEN_ROUTER_API_KEY=
XAI_API_KEY=

# ------------------------------------------------------------------------------
# Custom / Local OpenAI-Compatible Providers
# ------------------------------------------------------------------------------
# Use provider: "custom" / "ollama" / "vllm" in artemis.jsonc (or rely on
# CUSTOM_LLM_BASE_URL below as a default). All three reuse the OpenAI Chat
# Completions wire format, so any compatible endpoint works.
#
# Examples:
#   MiniMax (OpenAI-compatible chat completions):
#     CUSTOM_LLM_BASE_URL=https://api.minimax.io/v1
#     CUSTOM_LLM_MODEL=MiniMax-M3
#     CUSTOM_LLM_API_KEY=your_minimax_api_key_here
#   Local Ollama:
#     CUSTOM_LLM_BASE_URL=http://localhost:11434/v1
#     CUSTOM_LLM_MODEL=llava:13b
#     CUSTOM_LLM_API_KEY=ollama   # placeholder, Ollama ignores the value
#   Local vLLM:
#     CUSTOM_LLM_BASE_URL=http://localhost:8000/v1
#     CUSTOM_LLM_MODEL=Qwen/Qwen2-VL-7B-Instruct
#     CUSTOM_LLM_API_KEY=EMPTY    # placeholder, vLLM accepts "EMPTY" by default
#
# OPENAI_BASE_URL/OPENAI_API_KEY remain the global fallback for OpenAI nodes.
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
OPENAI_BASE_URL=

# Google Cloud Vision OCR (Optional - for advanced OCR processing)
OCR_API_KEY=

# Android ADB Connectivity (Optional - defaults to 127.0.0.1:5037)
ADB_HOST=127.0.0.1
ADB_PORT=5037
# ADB_DEVICE_SERIAL=
# Keep the display awake, falling back to a wake lock or safe heartbeat when needed.
# Set to false if Artemis is used with a personal device whose screen should time out.
ARTEMIS_KEEP_DEVICE_AWAKE=true
# UI hierarchy backend: auto (Accessibility Helper, UIAutomator2 fallback) | helper | uiautomator
ARTEMIS_HIERARCHY_BACKEND=auto
# Let tasks install / upgrade the Accessibility Helper APK on a device they hold.
# Set to false on shared or personal phones: then only `artemis helper install` installs it.
ARTEMIS_HELPER_AUTO_INSTALL=true

# Artemis Execution Defaults (flash or pro)
ARTEMIS_DEFAULT_PROFILE=flash
