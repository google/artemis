# ==============================================================================
# ☕ Latte Environment Configuration
# ==============================================================================

# 1. Primary LLM Provider API Key (Required for Agent Planning & Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Cloud Vision OCR API Key (Required for fast text perception & XML fusion)
OCR_API_KEY=your_google_cloud_vision_api_key_here

# Optional: Alternative LLM Providers
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
# XAI_API_KEY=your_xai_api_key_here

# Optional: Target Android Device Serial (Leave commented for auto-detection)
# ADB_DEVICE_SERIAL=emulator-5554

