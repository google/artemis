<idea-plugin>
    <id>com.google.artemis.studio</id>
    <name>ARTEMIS</name>
    <vendor>Google</vendor>

    <description><![CDATA[
        Thin-client Android Studio integration for the ARTEMIS natural-language
        on-device automation framework. Connects to a running ARTEMIS server over
        its HTTP API: lists connected devices, submits natural-language tasks
        (flash/pro profiles), polls task status, and stops running tasks.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.google.artemis.studio.settings.ArtemisSettings"/>
        <projectService serviceImplementation="com.google.artemis.studio.services.TaskPollingService"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.google.artemis.studio.settings.ArtemisConfigurable"
                id="com.google.artemis.studio.settings"
                displayName="ARTEMIS"/>

        <toolWindow
                id="ARTEMIS"
                anchor="right"
                canCloseContents="false"
                factoryClass="com.google.artemis.studio.toolwindow.ArtemisToolWindowFactory"/>

        <notificationGroup id="ARTEMIS_TASKS" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
