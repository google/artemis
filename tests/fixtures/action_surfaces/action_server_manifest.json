{
  "click": {
    "description": "Tap at a 0-1000 normalized [x, y] coordinate.",
    "inputSchema": {
      "properties": {
        "target": {
          "items": {
            "type": "integer"
          },
          "title": "Target",
          "type": "array"
        },
        "times": {
          "default": 1,
          "title": "Times",
          "type": "integer"
        },
        "delay_ms": {
          "default": 100,
          "title": "Delay Ms",
          "type": "integer"
        }
      },
      "required": [
        "target"
      ],
      "title": "clickArguments",
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "ActionCode": {
          "description": "Machine-readable outcome classification for a device action.",
          "enum": [
            "OK",
            "INVALID_ARGS",
            "TARGET_NOT_FOUND",
            "DEVICE_ERROR",
            "PACKAGE_NOT_FOUND",
            "TIMEOUT",
            "UNSUPPORTED"
          ],
          "title": "ActionCode",
          "type": "string"
        }
      },
      "description": "Outcome of one device action, independent of any transport or agent.",
      "properties": {
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "code": {
          "$ref": "#/$defs/ActionCode"
        },
        "action": {
          "title": "Action",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "normalized_coordinates": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Coordinates"
        },
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        }
      },
      "required": [
        "ok",
        "code",
        "action",
        "message"
      ],
      "title": "ActionResult",
      "type": "object"
    }
  },
